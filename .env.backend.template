DEBUG=
SECRET_KEY=

POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=app
POSTGRES_USER=postgres

# GlitchTip Error Tracking (get DSN from http://localhost:8001 after creating a project)
# Use glitchtip-web:8000 for Docker networking, not localhost:8001
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Composio (social publishing + engagement)
# ---------------------------------------------------------------------------
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=

# Auth config ids from the Composio dashboard (Auth Configs tab), one per toolkit.
# Point these at a custom auth config to use our own Meta app after App Review.
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=
COMPOSIO_FACEBOOK_AUTH_CONFIG_ID=

# Publicly reachable base URL of this API; Composio redirects here after OAuth.
# Use an ngrok/tunnel URL when testing the connect flow locally.
PUBLIC_API_URL=http://localhost:8000
